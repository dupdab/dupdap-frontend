NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# Sentry error tracking (frontend)
# DSN for the Sentry project. Leave empty to disable Sentry in local dev.
NEXT_PUBLIC_SENTRY_DSN=

# Used by @sentry/nextjs to upload source maps during production builds.
# Generate an auth token at https://sentry.io/settings/account/api/auth-tokens/
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
